# Copy to .env for local use. On Vercel, add these in Project → Settings → Environment Variables.

# --- Required for AI features (quiz, flashcards, tutor) ---
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.6-flash
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Admin login (placeholders only — set real values in local .env / host env) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VITE_ADMIN_EMAIL=admin@example.com

# --- Firebase client (public identifiers; also used if firebase-applet-config.json is present) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional
APP_URL=
PORT=3000
