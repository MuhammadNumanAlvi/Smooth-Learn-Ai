rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User-owned study documents & PDFs
    // Path: /users/{userId}/documents/{fileName}
    match /users/{userId}/documents/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.size < 25 * 1024 * 1024 // 25MB max
                    && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('text/plain'));
      allow update: if isOwner(userId)
                    && request.resource.size < 25 * 1024 * 1024
                    && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('text/plain'));
      allow delete: if isOwner(userId);
    }
  }
}
